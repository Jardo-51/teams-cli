# Credentials for auto-login.mjs. Copy this file to ".env" (git-ignored) and
# fill in your values:
#   cp .env.example .env
#
# A plain "cp" leaves the copy readable by everyone the umask allows, and this
# file holds a password in plain text, so tighten it afterwards:
#   chmod 600 .env
#
# Values are trimmed, and one surrounding pair of quotes is then removed. Wrap
# the value in quotes if yours begins or ends with a space.
TEAMS_EMAIL=you@example.com
TEAMS_PASSWORD=your-password
